[Unit]
Description=Run the ProofOdds job every three hours

[Timer]
# Publishing is idempotent — the entry for a date is written once and never
# rewritten — so running often is safe. The frequency is for grading and
# rebuilding after matches finish, not for publishing.
OnCalendar=*-*-* 00/3:07:00
RandomizedDelaySec=180
Persistent=true

[Install]
WantedBy=timers.target
