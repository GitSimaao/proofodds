[Unit]
Description=Send the ProofOdds weekly scorecard on Monday mornings

[Timer]
# Monday 09:00 UTC. Late enough that Sunday's late kick-offs have results and
# closing odds in the football-data.co.uk file, early enough to be the first
# thing in the inbox on Monday.
OnCalendar=Mon *-*-* 09:00:00
RandomizedDelaySec=300
Persistent=true

[Install]
WantedBy=timers.target
