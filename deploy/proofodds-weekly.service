[Unit]
Description=ProofOdds — send the weekly scorecard email
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=proofodds
Group=proofodds
WorkingDirectory=/opt/proofodds
EnvironmentFile=-/opt/proofodds/.env
ExecStart=/opt/proofodds/.venv/bin/python scripts/weekly.py --send
TimeoutStartSec=300

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/proofodds

[Install]
WantedBy=multi-user.target
