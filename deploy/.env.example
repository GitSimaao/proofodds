# Copy to /opt/proofodds/.env — never commit the real file.

PROOFODDS_URL=https://proofodds.com
PROOFODDS_REPO=https://github.com/yourname/proofodds
PROOFODDS_EMAIL=hello@proofodds.com

# Free token from football-data.org — used for upcoming fixtures.
# Without it the job falls back to data/fixtures.csv.
PROOFODDS_FDORG_TOKEN=

# Which divisions to publish. Codes are football-data.co.uk's:
#   E0 Premier League   E1 Championship   SP1 La Liga   I1 Serie A
#   D1 Bundesliga       F1 Ligue 1        P1 Primeira Liga
#   N1 Eredivisie
# Add a division only after `python scripts/check_names.py --leagues XX` is
# clean: a club whose name does not resolve is sealed into the ledger under a
# spelling the grader cannot join, and the ledger is never rewritten.
PROOFODDS_LEAGUES=E0,E1,SP1,I1,D1,F1,P1,N1

# Optional: live pre-match odds. Grading does not need this — closing prices
# come from football-data.co.uk, free.
PROOFODDS_ODDS_PROVIDER=none
PROOFODDS_ODDS_API_KEY=

# --- newsletter --------------------------------------------------------------
# Kit form action (Grow -> Forms -> Embed -> HTML). Without it the signup box
# does not render at all.
PROOFODDS_SIGNUP_ACTION=

# Kit v4 API key (Settings -> Developer). Needed only for the weekly send.
PROOFODDS_KIT_API_KEY=

# Minutes between creating the broadcast and Kit sending it — your undo window.
PROOFODDS_NEWSLETTER_DELAY_MIN=15

# Name shown as the data controller on the privacy page.
PROOFODDS_CONTROLLER=

# Where alerts go: a failed run, or a fixture feed that has stopped delivering.
# One HTTP POST per alert, in ntfy's format. Install the ntfy app, subscribe to
# a topic with a long random name, and put https://ntfy.sh/<that-name> here.
# Unset, alerts are written to alerts.log and reach nobody.
# Test with: python -m proofodds.alert test
PROOFODDS_ALERT_URL=

# Encrypts held ("reveal at kickoff") guest entries into held/, so they
# survive the loss of this disk. Generate once and keep a copy off the server:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Without it nothing can be held. If it is lost, held entries cannot be opened.
PROOFODDS_EMBARGO_KEY=

# 0 turns the Nations League page into a "retired" note and stops the calls
# to TheStatsAPI. Retired on 9 October 2026.
PROOFODDS_NATIONS=0

# Alert when the disk holding the ledger is fuller than this.
PROOFODDS_DISK_ALERT_PERCENT=85
