# Secrets — never commit. scripts/setup-git.sh refuses to run without this line.
.env

# Generated output
site/
site-preview/
_replay/

# Data cache. Re-downloaded by data.refresh() on every run, and the current
# season's file changes constantly — committing it would show the tree as
# permanently modified and bury the ledger commits, which are the evidence,
# under a stream of noise.
data/

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Session backups (rollback artefacts, not record)
*.bak*

# Editor / OS
.DS_Store
*.swp
