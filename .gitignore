# Secrets — never commit. scripts/setup-git.sh refuses to run without this line.
.env

# Generated output
site/
site-preview/
_replay/

# Data cache. Re-downloaded by data.refresh() on every run, and the current
# season's file changes constantly — committing it would show the tree as
# permanently modified and bury the ledger commits, which are the evidence,
# under a stream of noise.
data/

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# The OpenTimestamps client caches calendar responses in $HOME/.cache,
# and this service's home IS the repository root. daily.py commits explicit
# paths so the job would never add it — but `git add -A`, which we use by
# hand, would sweep it straight into the public ledger repository.
.cache/

# Session backups (rollback artefacts, not record)
*.bak*

# Editor / OS
.DS_Store
*.swp

# SSH deploy key - never commit.
.ssh/
